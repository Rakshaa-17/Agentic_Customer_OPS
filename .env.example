# LLM Provider Configuration (groq, gemini, or openai)
MODEL_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_SUPERVISOR_MODEL=llama-3.3-70b-versatile
GROQ_SPECIALIST_MODEL=llama-3.3-70b-versatile
GROQ_TRIAGE_MODEL=llama-3.1-8b-instant

# Google Gemini Configuration (optional fallback)
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-2.0-flash
GEMINI_SUPERVISOR_MODEL=gemini-1.5-pro

# OpenAI Configuration (optional fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Observability (Configured in Milestone 5)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
